# Salin jadi .env untuk uji lokal:  copy .env.example .env
# Jangan pernah commit file .env berisi kredensial asli.

# --- Cara 1: MySQL lokal (XAMPP/Laragon) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=billard_hub

# --- Cara 2: MySQL serverless (mis. TiDB Serverless / PlanetScale) ---
# Isi DATABASE_URL untuk mengesampingkan cara 1 (password dengan karakter khusus
# harus di-URL-encode, mis. '@' -> '%40').
# DATABASE_URL=mysql://user:password@host:4000/billard_hub
# DB_SSL=0  -> nonaktifkan TLS (hanya untuk MySQL lokal tanpa sertifikat)
# DB_SSL_CA -> path CA bundle kustom jika provider memberikannya

# --- Wajib di Vercel ---
# Generator: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-64-karakter
